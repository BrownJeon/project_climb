# =============================================
# TheRoute Backend - 환경 변수 템플릿
# 실제 값은 .env에 작성 (Git에 커밋 금지)
# pm2 ecosystem cwd가 프로젝트 루트라도 backend/src/index.js가
# require('dotenv').config({ path: __dirname + '/../.env' })로 항상 backend/.env를 로드
# =============================================

# --- 서버 ---
NODE_ENV=production
PORT=3100

# --- MariaDB (NAS) ---
DB_HOST=192.168.219.154
DB_PORT=3306
DB_USER=the-route
DB_PWD=replace-me
DB_NAME=the-route

# Connection Pool
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# --- JWT (AUTH_ENABLED=true일 때만 사용) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- 인증 모드 ---
# false: 1인용 (디폴트 사용자 id=1 자동 주입)
# true:  JWT 검증 필수
AUTH_ENABLED=false

# --- 미디어 스토리지 ---
MEDIA_UPLOAD_PATH=/home/brownjeon/NFS/homes/brownjeon/project/TheRoute/uploads
MEDIA_BASE_URL=https://climb.미라클펭귄.com/uploads

# --- Claude CLI (훈련 분석) ---
# 서버에서 `claude login` 1회 인증 필요. 비용 0 (구독 기반)
CLAUDE_CLI_PATH=claude
TRAINING_ANALYZE_DAILY_LIMIT=50

# --- (선택) SNS OAuth — AUTH_ENABLED=true 시 사용 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
